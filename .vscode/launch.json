  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: InkWell Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/InkWell.Cli/bin/Debug/net9.0/inkwell",
      "args": [
        "compile",
        "doc/sample",
        "doc/compiled"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
